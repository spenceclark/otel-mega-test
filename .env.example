# Copy to .env (git-ignored) only if you need to override defaults. Compose reads .env automatically.
# Nothing here is ever baked into the browser bundle.

# Model mode: scripted (deterministic, default) | live (needs ANTHROPIC_API_KEY)
DEMO_MODE=scripted
DEMO_MODEL_ID=claude-haiku-5-5
DEMO_MAX_OUTPUT_TOKENS=512
DEMO_REQUEST_TIMEOUT_SECONDS=30
# ANTHROPIC_API_KEY=sk-ant-...            # live mode only; passed to api + worker containers
# ANTHROPIC_BASE_URL=                     # optional proxy; unset any value your shell inherited (see docs/troubleshooting.md)

# Fixture latency (ms). SQL delay is carried by the query itself (pg_sleep in a MATERIALIZED CTE).
DEMO_SQL_DELAY_MS=300
DEMO_SHIPPING_DELAY_MS=500
DEMO_BRANCH_TIMEOUT_MS=5000
DEMO_SHIPPING_FAIL=false

# Logfire fan-out (Collector only). Enable with: demo up --logfire
# LOGFIRE_TOKEN=replace-locally
LOGFIRE_OTLP_ENDPOINT=https://logfire-eu.pydantic.dev

# local | ci | demo
DEMO_ENVIRONMENT=local
